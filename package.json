{
  "name": "lanka-offers",
  "version": "1.0.0",
  "description": "TypeScript scrapers for Sri Lankan bank offers — modern, type-safe, loosely coupled",
  "scripts": {
    "api": "ts-node -r tsconfig-paths/register src/api/server.ts",
    "scrape": "ts-node -r tsconfig-paths/register src/cli/scrape.ts",
    "migrate": "ts-node -r tsconfig-paths/register src/infrastructure/db/migrate.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest --passWithNoTests",
    "evaluate:quality": "ts-node -r tsconfig-paths/register src/cli/quality-evaluation.ts",
    "renormalize:offers": "ts-node -r tsconfig-paths/register src/infrastructure/db/renormalize-offers.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --passWithNoTests --coverage",
    "browser:install": "browsers install chrome-headless-shell@stable",
    "browser:list": "browsers list",
    "scrape:hnb": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=hnb --cache",
    "scrape:sampath": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=sampath --cache",
    "scrape:boc": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=boc --cache",
    "scrape:peoples": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=peoples --cache",
    "scrape:ndb": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=ndb --cache",
    "scrape:seylan": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=seylan --cache",
    "scrape:dfcc": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=dfcc --cache",
    "scrape:pabc": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=pabc --cache",
    "scrape:nsb": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=nsb --cache",
    "scrape:combank": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=combank --cache",
    "scrape:all": "ts-node -r tsconfig-paths/register src/cli/scrape.ts --bank=all --cache",
    "geo:hnb": "ts-node -r tsconfig-paths/register src/cli/geocode.ts --bank=hnb --stats",
    "geo:sampath": "ts-node -r tsconfig-paths/register src/cli/geocode.ts --bank=sampath --stats",
    "geo:boc": "ts-node -r tsconfig-paths/register src/cli/geocode.ts --bank=boc --stats",
    "geo:all": "ts-node -r tsconfig-paths/register src/cli/geocode.ts --bank=all --stats",
    "geo:dry-run": "ts-node -r tsconfig-paths/register src/cli/geocode.ts --bank=hnb --dry-run",
    "llm:revalidate:hnb": "ts-node -r tsconfig-paths/register src/cli/revalidate-llm.ts --bank=hnb",
    "llm:revalidate:boc": "ts-node -r tsconfig-paths/register src/cli/revalidate-llm.ts --bank=boc"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@neon/config": "^1.0.5",
    "@neon/env": "^1.1.5",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.3.0"
  }
}
