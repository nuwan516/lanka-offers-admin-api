# Lanka Offers — environment configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env` with real secrets.

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection — used for all app/runtime queries.
DATABASE_URL=
# Direct (unpooled) connection — used for schema migrations only.
DATABASE_URL_UNPOOLED=

# ─── LLM validation policy ────────────────────────────────────────────────────
# Master switch for LLM-based semantic validation.
LLM_VALIDATION_ENABLED=true
# free_only (default) | allow_paid
LLM_MODE=free_only
# Preferred free-tier provider. Never inferred from "whichever key exists".
LLM_PRIMARY_PROVIDER=gemini
# Paid fallback (e.g. DeepSeek) NEVER activates unless explicitly set to true.
ALLOW_PAID_LLM_FALLBACK=false

# ─── LLM provider API keys ────────────────────────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ─── Geo enrichment ───────────────────────────────────────────────────────────
GEO_PROVIDER_CALLS_ENABLED=true
PLACES_ENRICHMENT_ENABLED=false
GOOGLE_MAPS_API_KEY=

# ─── Monthly request budgets (CostGuard) ─────────────────────────────────────
GEMINI_MONTHLY_REQUEST_LIMIT=1000
DEEPSEEK_MONTHLY_REQUEST_LIMIT=0
OPENAI_MONTHLY_REQUEST_LIMIT=1000
GOOGLE_GEOCODING_MONTHLY_LIMIT=10000
GOOGLE_PLACES_MONTHLY_LIMIT=10000

# CostGuard thresholds — ALLOW below warn%, WARN below block%, BLOCK at/above block%.
COST_GUARD_WARN_PERCENT=70
COST_GUARD_BLOCK_PERCENT=95

# ─── Duplicate detection ──────────────────────────────────────────────────────
DUPLICATE_LIKELY_THRESHOLD=60
DUPLICATE_EXACT_THRESHOLD=90
DUPLICATE_REVIEW_TRIGGER_THRESHOLD=60
DUPLICATE_CANDIDATE_SEARCH_LIMIT=50
DUPLICATE_CANDIDATE_MAX_STALE_DAYS=30

# ─── Quality decision ─────────────────────────────────────────────────────────
QUALITY_AUTO_APPROVE_SCORE=90
QUALITY_REJECT_SCORE_FLOOR=30
QUALITY_ALLOW_RULE_ONLY_AUTO_APPROVE=false

# ─── Admin API server ─────────────────────────────────────────────────────────
API_PORT=3001
